# Copie para terraform.tfvars (não versionado) e ajuste.

aws_region   = "us-east-1"
project_name = "tfpratica"
environment  = "lab"

# Buckets auxiliares (variável de coleção). Adicione ou remova chaves e observe o plan.
auxiliary_buckets = {
  "arquivos-extras" = { purpose = "Arquivos extras de demonstração", versioning = false }
  "relatorios"      = { purpose = "Relatórios de demonstração (com versionamento)", versioning = true }
}

# Respostas de erro do CloudFront (opcional; gera um bloco por entrada via dynamic).
# error_pages = {
#   "403" = { response_code = 404, page_path = "/404.html" }
#   "404" = { response_code = 404, page_path = "/404.html", min_ttl = 30 }
# }

# Domínio personalizado (opcional). Hosted Zone e certificado JÁ devem existir.
# enable_custom_domain    = true
# hosted_zone_name        = "exemplo.com.br"
# subdomain               = "galeria"
# certificate_domain_name = "*.exemplo.com.br" # nome principal do certificado em us-east-1
# certificate_arn         = "arn:aws:acm:us-east-1:111122223333:certificate/..." # opcional
